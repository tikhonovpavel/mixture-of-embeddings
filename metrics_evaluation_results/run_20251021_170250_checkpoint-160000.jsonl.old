eturn", "metrics_dual_stream": {"rouge": {"rouge1": 0.22695035460992907, "rouge2": 0.05714285714285714, "rougeL": 0.12765957446808512, "rougeLsum": 0.19148936170212766}, "bleu": {"bleu": 0.0, "precisions": [0.6470588235294118, 0.16, 0.02040816326530612, 0.0], "brevity_penalty": 0.02060229212491954, "length_ratio": 0.20481927710843373, "translation_length": 51, "reference_length": 249}, "bert_score_precision": 0.8592667579650879, "bert_score_recall": 0.7986647486686707, "bert_score_f1": 0.8278581500053406}, "metrics_original": {"rouge": {"rouge1": 0.16487455197132617, "rouge2": 0.036101083032490974, "rougeL": 0.11469534050179211, "rougeLsum": 0.14336917562724014}, "bleu": {"bleu": 0.0, "precisions": [0.5510204081632653, 0.14583333333333334, 0.02127659574468085, 0.0], "brevity_penalty": 0.01687988414878991, "length_ratio": 0.19678714859437751, "translation_length": 49, "reference_length": 249}, "bert_score_precision": 0.851415753364563, "bert_score_recall": 0.7911670804023743, "bert_score_f1": 0.8201864361763}, "original_model_loss_on_full_text": 1.9863274097442627}
